{
  "version": 2,
  "wake": {
    "provider": "deepgram_vad",
    "word": "Emma",
    "accessKeyEnv": "PICOVOICE_ACCESS_KEY",
    "keywordPath": "",
    "sensitivity": 0.65,
    "speechThreshold": 450,
    "preRollMs": 600,
    "silenceMs": 1100,
    "maxSegmentMs": 8000
  },
  "stt": {
    "provider": "deepgram",
    "apiKeyEnv": "DEEPGRAM_API_KEY",
    "model": "nova-3",
    "languageMode": "selected",
    "endpointingMs": 250,
    "utteranceEndMs": 1000
  },
  "tts": {
    "provider": "elevenlabs",
    "apiKeyEnv": "ELEVENLABS_API_KEY",
    "voiceId": "SET_YOUR_ELEVENLABS_VOICE_ID",
    "model": "eleven_flash_v2_5",
    "outputFormat": "pcm_24000"
  },
  "session": {
    "followUpSeconds": 25,
    "maxSeconds": 180
  }
}
