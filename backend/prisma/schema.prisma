// Secretary Core data model — VCUF backend
// Every table belongs to a company (multi-tenant from day one).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users                        User[]
  clients                      Client[]
  contacts                     Contact[]
  documentRecords              DocumentRecord[]
  industries                   Industry[]
  industryServiceLinks         IndustryServiceLink[]
  jobs                         Job[]
  leads                        Lead[]
  auditLogs                    AuditLog[]
  serviceCatalogueItems        ServiceCatalogueItem[]
  quotes                       Quote[]
  jobOpenings                  JobOpening[]
  candidates                   Candidate[]
  playbooks                    Playbook[]
  playbookRuns                 PlaybookRun[]
  learningRules                LearningRule[]
  communicationRecords         CommunicationRecord[]
  communicationIntakes         CommunicationIntake[]
  notificationAcknowledgements NotificationAcknowledgement[]
  portfolioPhotos              PortfolioPhoto[]
  photoServiceSelections       PhotoServiceSelection[]
  businessContextItems         BusinessContextItem[]
  websiteAudits                WebsiteAudit[]
  websiteAuditFindings         WebsiteAuditFinding[]
  websiteContentProposals      WebsiteContentProposal[]
  tasks                        Task[]

  @@map("companies")
}

model User {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  email               String   @unique
  passwordHash        String   @map("password_hash")
  displayName         String   @map("display_name")
  role                String   @default("worker")
  permissions         String[]
  // Job Allocation and Capacity Management Module — real capacity inputs.
  // Skills are free-text technical tags (e.g. "electrical", "plastering"),
  // entered by the user/admin — never invented by the system.
  skills              String[] @default([])
  weeklyCapacityHours Int      @default(40) @map("weekly_capacity_hours")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  company       Company    @relation(fields: [companyId], references: [id])
  auditLogs     AuditLog[]
  assignedJobs  Job[]      @relation("AssignedJobs")
  assignedTasks Task[]     @relation("AssignedTasks")

  @@map("users")
}

model Client {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  displayName     String   @map("display_name")
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  companyName     String?  @map("company_name")
  emailPrimary    String?  @map("email_primary")
  phonePrimary    String?  @map("phone_primary")
  clientType      String?  @map("client_type")
  billingLine1    String?  @map("billing_address_line1")
  billingCity     String?  @map("billing_city")
  billingPostcode String?  @map("billing_postcode")
  notes           String?
  source          String?
  // Data Quality Engine — merge_clients archives a duplicate client instead
  // of hard-deleting it (see dataQualityService.mergeClients), reusing the
  // same isActive soft-delete pattern already used by User/ServiceCatalogueItem
  // rather than inventing a new "archived" concept. Defaults to true so
  // every existing client remains active without a data migration.
  isActive        Boolean  @default(true) @map("is_active")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id])
  jobs                 Job[]
  quotes               Quote[]
  communicationRecords CommunicationRecord[]
  communicationIntakes CommunicationIntake[]
  portfolioPhotos      PortfolioPhoto[]
  tasks                Task[]
  contacts             Contact[]
  documentRecords      DocumentRecord[]

  @@index([companyId])
  @@map("clients")
}

model Job {
  id                     String    @id @default(uuid())
  companyId              String    @map("company_id")
  clientId               String    @map("client_id")
  jobTitle               String    @map("job_title")
  jobStatus              String    @default("nova") @map("job_status")
  propertyAddress        String?   @map("property_address")
  assignedUserId         String?   @map("assigned_user_id")
  // Job Allocation and Capacity Management Module — real inputs used to
  // compute capacity. Optional because not every job has an estimate yet;
  // capacity checks explicitly report when a job cannot be counted because
  // this data is missing (the system must say what is missing, not guess).
  estimatedDurationHours Float?    @map("estimated_duration_hours")
  requiredSkills         String[]  @default([]) @map("required_skills")
  // Service Catalogue Module — optional link back to the catalogue entry
  // this job was based on, so pricing/duration data entered once in the
  // catalogue can be reused (and later rolled up for profitability),
  // without forcing every job to originate from a catalogue item.
  serviceCatalogueItemId String?   @map("service_catalogue_item_id")
  plannedStartAt         DateTime? @map("planned_start_at")
  plannedEndAt           DateTime? @map("planned_end_at")
  notes                  String?
  createdBy              String?   @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id])
  client               Client                @relation(fields: [clientId], references: [id])
  assignedUser         User?                 @relation("AssignedJobs", fields: [assignedUserId], references: [id])
  serviceCatalogueItem ServiceCatalogueItem? @relation(fields: [serviceCatalogueItemId], references: [id])
  quotes               Quote[]
  communicationRecords CommunicationRecord[]
  portfolioPhotos      PortfolioPhoto[]
  tasks                Task[]
  documentRecords      DocumentRecord[]

  @@index([companyId])
  @@index([clientId])
  @@index([assignedUserId])
  @@index([serviceCatalogueItemId])
  @@map("jobs")
}

// Contact Directory — people are independent records rather than fields on
// a client. A contact may be linked to a client, but can also exist before a
// client account is created. Source fields keep every fact traceable.
model Contact {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  clientId          String?  @map("client_id")
  displayName       String   @map("display_name")
  jobTitle          String?  @map("job_title")
  department        String?
  email             String?
  phone             String?
  preferredChannel  String?  @map("preferred_channel")
  preferredLanguage String?  @map("preferred_language")
  source            String   @default("user_input")
  sourceReference   String?  @map("source_reference")
  notes             String?
  isActive          Boolean  @default(true) @map("is_active")
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])

  @@index([companyId])
  @@index([companyId, clientId])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@map("contacts")
}

// Document Registry — metadata and references only. The MVP deliberately
// does not claim to upload, encrypt or retain file bytes without an authorised
// storage connector. Relations, sensitivity and verification remain explicit.
model DocumentRecord {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  clientId           String?   @map("client_id")
  jobId              String?   @map("job_id")
  title              String
  documentType       String    @map("document_type")
  documentReference  String    @map("document_reference")
  source             String    @default("user_input")
  sensitivity        String    @default("normal")
  verificationStatus String    @default("user_entered") @map("verification_status")
  issuedAt           DateTime? @map("issued_at")
  expiresAt          DateTime? @map("expires_at")
  notes              String?
  isActive           Boolean   @default(true) @map("is_active")
  createdBy          String?   @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])
  job     Job?    @relation(fields: [jobId], references: [id])

  @@index([companyId])
  @@index([companyId, clientId])
  @@index([companyId, jobId])
  @@index([companyId, documentType])
  @@map("document_records")
}

model Lead {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  name              String
  phone             String?
  email             String?
  serviceRequested  String?  @map("service_requested")
  location          String?
  source            String?
  urgency           String?
  leadStatus        String   @default("new") @map("lead_status")
  notes             String?
  convertedClientId String?  @map("converted_client_id")
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("leads")
}

// Service Catalogue Module — the company's real, user-entered menu of
// services. Nothing here is invented by the system: name, description,
// pricing and duration are entered by the user and are used later to
// prefill jobs and (eventually) quotes and website content, so the same
// real facts propagate everywhere instead of being retyped or guessed.
model ServiceCatalogueItem {
  id                    String   @id @default(uuid())
  companyId             String   @map("company_id")
  name                  String
  description           String?
  category              String?
  basePriceMin          Float?   @map("base_price_min")
  basePriceMax          Float?   @map("base_price_max")
  priceUnit             String?  @map("price_unit")
  defaultDurationHours  Float?   @map("default_duration_hours")
  defaultRequiredSkills String[] @default([]) @map("default_required_skills")
  isActive              Boolean  @default(true) @map("is_active")
  createdBy             String?  @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company         Company                 @relation(fields: [companyId], references: [id])
  jobs            Job[]
  quoteItems      QuoteItem[]
  photoSelections PhotoServiceSelection[]
  industryLinks   IndustryServiceLink[]

  @@index([companyId])
  @@map("service_catalogue_items")
}

// Quote, Pricing and Profitability Module — turns real service-catalogue
// prices and real job data into a real, itemised quote for a client, and
// computes actual margin from real entered costs. Nothing here is invented:
// unit prices and unit costs are either pulled from a service catalogue
// entry the user created, or typed in directly. If a cost is not entered,
// margin is left unknown for that line rather than assumed to be 100%.
model Quote {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  clientId    String    @map("client_id")
  jobId       String?   @map("job_id")
  title       String
  quoteStatus String    @default("draft") @map("quote_status")
  notes       String?
  validUntil  DateTime? @map("valid_until")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id])
  client  Client      @relation(fields: [clientId], references: [id])
  job     Job?        @relation(fields: [jobId], references: [id])
  items   QuoteItem[]

  @@index([companyId])
  @@index([clientId])
  @@index([jobId])
  @@map("quotes")
}

model QuoteItem {
  id                     String   @id @default(uuid())
  quoteId                String   @map("quote_id")
  serviceCatalogueItemId String?  @map("service_catalogue_item_id")
  description            String
  quantity               Float    @default(1)
  unitPrice              Float    @map("unit_price")
  unitCost               Float?   @map("unit_cost")
  sortOrder              Int      @default(0) @map("sort_order")
  createdAt              DateTime @default(now()) @map("created_at")

  quote                Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceCatalogueItem ServiceCatalogueItem? @relation(fields: [serviceCatalogueItemId], references: [id])

  @@index([quoteId])
  @@index([serviceCatalogueItemId])
  @@map("quote_items")
}

// Recruitment and Workforce Expansion Module — see project instructions
// section 6. Every field here is what the user entered: reason, urgency,
// required skills, experience and language requirements are never invented,
// and the module never legally hires anyone, sets a wage, or confirms
// employment terms — it only tracks openings and candidates and drafts
// content for the user to review and use elsewhere.
model JobOpening {
  id                       String   @id @default(uuid())
  companyId                String   @map("company_id")
  title                    String
  reason                   String?
  urgency                  String   @default("medium")
  openingStatus            String   @default("draft") @map("opening_status")
  skillsRequired           String[] @default([]) @map("skills_required")
  expectedTasks            String?  @map("expected_tasks")
  minExperienceYears       Float?   @map("min_experience_years")
  preferredExperienceYears Float?   @map("preferred_experience_years")
  languageRequirements     String[] @default([]) @map("language_requirements")
  availabilityRequirements String?  @map("availability_requirements")
  description              String?
  // The generated advert is stored so it can be reviewed and reused, but it
  // is only ever built from the real fields above — see
  // recruitmentService.buildAdvertText. Nothing is published automatically;
  // there is no job-board connector.
  draftAdvertText          String?  @map("draft_advert_text")
  createdBy                String?  @map("created_by")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id])
  candidates Candidate[]

  @@index([companyId])
  @@map("job_openings")
}

model Candidate {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  jobOpeningId String   @map("job_opening_id")
  name         String
  email        String?
  phone        String?
  stage        String   @default("new")
  notes        String?
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id])
  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id])

  @@index([companyId])
  @@index([jobOpeningId])
  @@map("candidates")
}

// Playbook Engine — a saved, reusable workflow: an ordered list of Voice/Text
// Command Layer templates (the same syntax a user could type by hand, with
// {placeholder} variables). Running a playbook resolves the placeholders and
// dispatches each step through the exact same Action Engine
// (dispatchParsedCommand) a typed command would use — there is no separate,
// divergent execution path, and no business logic lives only in a prompt.
// Running a playbook is itself a risky, potentially multi-step action, so it
// follows the confirmationRequired pattern established for employee
// management: a request without confirmed: true returns a preview of every
// resolved step and its interpreted intent, and changes nothing.
model Playbook {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  name          String
  description   String?
  stepTemplates String[] @default([]) @map("step_templates")
  isActive      Boolean  @default(true) @map("is_active")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyId], references: [id])
  runs    PlaybookRun[]

  @@index([companyId])
  @@map("playbooks")
}

model PlaybookRun {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  playbookId  String   @map("playbook_id")
  triggeredBy String?  @map("triggered_by")
  variables   Json?
  stepResults Json
  overallOk   Boolean  @map("overall_ok")
  createdAt   DateTime @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id])
  playbook Playbook @relation(fields: [playbookId], references: [id])

  @@index([companyId])
  @@index([playbookId])
  @@map("playbook_runs")
}

// Learning Engine — see project instructions section 11 and the MVP
// priority list ("basic learning of aliases and workflows"). The strongest
// learning signal is explicit user correction/teaching, never an inferred
// guess — so every rule here is created deliberately by a user, is visible,
// editable and reversible (archive, don't hard-delete-and-forget), and
// nothing here silently overrides system behaviour on a single weak signal.
// A rule with aliasFor set is also used as a real text-substitution step
// (LearningEngine#resolveLearningAliases) applied before the Voice/Text
// Command Layer parses a command, so a learned alias actually changes how
// commands and playbook steps are interpreted — not just a static glossary.
model LearningRule {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  term      String
  meaning   String
  aliasFor  String?  @map("alias_for")
  category  String?
  status    String   @default("active")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("learning_rules")
}

// Communication Log Module — the manual-entry foundation of the
// Communication Intelligence Module. See VCUF master documentation and the
// vcubf-programmer-skill CRM rule: a communication must never live only in
// an external inbox/chat app — it belongs on the CRM record it relates to.
// Automated extraction from email/WhatsApp/SMS connectors is out of scope
// for this slice (no connector exists yet); every field here is exactly
// what the user typed in, never invented. This model is deliberately
// generic (channel/direction/summary/fullText) so a future connector-driven
// extraction workflow can write into the same table and CRM linkage instead
// of being a disconnected system.
model CommunicationRecord {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  clientId       String    @map("client_id")
  jobId          String?   @map("job_id")
  channel        String
  direction      String
  summary        String
  fullText       String?   @map("full_text")
  occurredAt     DateTime  @map("occurred_at")
  followUpNeeded Boolean   @default(false) @map("follow_up_needed")
  followUpDueAt  DateTime? @map("follow_up_due_at")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company Company              @relation(fields: [companyId], references: [id])
  client  Client               @relation(fields: [clientId], references: [id])
  job     Job?                 @relation(fields: [jobId], references: [id])
  tasks   Task[]
  intake  CommunicationIntake?

  @@index([companyId])
  @@index([clientId])
  @@index([jobId])
  @@map("communication_records")
}

// Communication Intelligence intake — preserves the original inbound
// message before a client identity is known. Extraction results and reply
// drafts are reviewable internal data; conversion links the same intake to
// the resulting/reused Client and CommunicationRecord so source provenance
// is never lost.
model CommunicationIntake {
  id                    String    @id @default(uuid())
  companyId             String    @map("company_id")
  clientId              String?   @map("client_id")
  communicationRecordId String?   @unique @map("communication_record_id")
  channel               String
  senderName            String?   @map("sender_name")
  senderEmail           String?   @map("sender_email")
  senderPhone           String?   @map("sender_phone")
  messageText           String    @map("message_text")
  receivedAt            DateTime  @map("received_at")
  sourceReference       String?   @map("source_reference")
  intakeStatus          String    @default("new") @map("intake_status")
  resolutionNeeded      Boolean   @default(true) @map("resolution_needed")
  resolvedAt            DateTime? @map("resolved_at")
  resolvedBy            String?   @map("resolved_by")
  extractedData         Json?     @map("extracted_data")
  replyDraft            String?   @map("reply_draft")
  createdBy             String?   @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  communicationRecord CommunicationRecord? @relation(fields: [communicationRecordId], references: [id])

  @@index([companyId, intakeStatus])
  @@index([companyId, resolutionNeeded])
  @@index([clientId])
  @@map("communication_intakes")
}

// Task Management — one structured task list shared by CRM, jobs,
// communication, employees, calendar and capacity. A task may be linked to
// any of those real records, but never exists only inside an external
// calendar. dueAt + assignedUserId place it on the employee agenda;
// estimatedDurationHours contributes to real weekly load when known.
model Task {
  id                     String    @id @default(uuid())
  companyId              String    @map("company_id")
  clientId               String?   @map("client_id")
  jobId                  String?   @map("job_id")
  communicationRecordId  String?   @map("communication_record_id")
  assignedUserId         String?   @map("assigned_user_id")
  title                  String
  description            String?
  taskStatus             String    @default("open") @map("task_status")
  priority               String    @default("normal")
  category               String    @default("administrative")
  source                 String    @default("user_input")
  dueAt                  DateTime? @map("due_at")
  estimatedDurationHours Float?    @map("estimated_duration_hours")
  completedAt            DateTime? @map("completed_at")
  createdBy              String?   @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  job                 Job?                 @relation(fields: [jobId], references: [id])
  communicationRecord CommunicationRecord? @relation(fields: [communicationRecordId], references: [id])
  assignedUser        User?                @relation("AssignedTasks", fields: [assignedUserId], references: [id])

  @@index([companyId, taskStatus])
  @@index([assignedUserId, dueAt])
  @@index([clientId])
  @@index([jobId])
  @@index([communicationRecordId])
  @@map("tasks")
}

// Notification and Escalation Module — a unified "things needing attention"
// feed. This module deliberately stores no duplicate business facts: every
// item on the feed is computed fresh, on read, from real existing data
// already owned by other modules (overdue Communication Log follow-ups,
// Job Allocation/Capacity Management overload weeks, quotes approaching or
// past their valid_until date) — see notificationService.ts. The only thing
// persisted here is which computed item a user has explicitly acknowledged
// (marked as seen/handled), keyed by a deterministic notificationKey (e.g.
// "follow_up:<communicationRecordId>") so the same underlying fact does not
// keep resurfacing once handled, without ever deleting or altering the
// underlying record it points to. Acknowledging is reversible (delete the
// row = unacknowledge), matching the Learning Engine's
// visible/editable/reversible standard for low-risk state changes.
model NotificationAcknowledgement {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  notificationKey String   @map("notification_key")
  acknowledgedBy  String?  @map("acknowledged_by")
  acknowledgedAt  DateTime @default(now()) @map("acknowledged_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, notificationKey])
  @@index([companyId])
  @@map("notification_acknowledgements")
}

// Portfolio and Photo Intelligence Module — the manual-entry foundation of a
// future automated photo-selection/website-publishing workflow. See VCUF
// master documentation and the vcubf-programmer-skill "Photo and portfolio
// rule": every selected photograph must have a source, an optional link to
// the client/job it relates to, and an explicit public-use status. This
// slice deliberately does not store or move actual image files — there is
// no upload/storage connector yet — `filename` is just the literal
// filename/reference the user typed in, never invented. `usableForMarketing`
// is only an internal tag reviewed by the user; it does not publish
// anything to a website or social channel by itself (no connector exists
// for that yet, and publishing is a separate, higher-risk future action).
model PortfolioPhoto {
  id                        String    @id @default(uuid())
  companyId                 String    @map("company_id")
  clientId                  String?   @map("client_id")
  jobId                     String?   @map("job_id")
  filename                  String
  caption                   String?
  tags                      String[]  @default([])
  takenAt                   DateTime? @map("taken_at")
  source                    String
  usableForMarketing        Boolean   @default(false) @map("usable_for_marketing")
  usableForMarketingNotes   String?   @map("usable_for_marketing_notes")
  qualityReviewStatus       String    @default("unreviewed") @map("quality_review_status")
  duplicateReviewStatus     String    @default("unreviewed") @map("duplicate_review_status")
  sensitiveDataReviewStatus String    @default("unreviewed") @map("sensitive_data_review_status")
  usagePermissionStatus     String    @default("unknown") @map("usage_permission_status")
  createdBy                 String?   @map("created_by")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  company           Company                 @relation(fields: [companyId], references: [id])
  client            Client?                 @relation(fields: [clientId], references: [id])
  job               Job?                    @relation(fields: [jobId], references: [id])
  serviceSelections PhotoServiceSelection[]

  @@index([companyId])
  @@index([clientId])
  @@index([jobId])
  @@map("portfolio_photos")
}

// A confirmed, internal portfolio choice for one real Service Catalogue
// item. Candidate generation is never persisted and never claims to inspect
// the image: it is derived only from explicit job/service links or exact
// user-entered tags. This record stores the evidence seen at confirmation
// time and has no publishing side effect.
model PhotoServiceSelection {
  id                     String   @id @default(uuid())
  companyId              String   @map("company_id")
  serviceCatalogueItemId String   @map("service_catalogue_item_id")
  portfolioPhotoId       String   @map("portfolio_photo_id")
  isSelected             Boolean  @default(true) @map("is_selected")
  ownProductionRequired  Boolean  @default(true) @map("own_production_required")
  reviewNotes            String?  @map("review_notes")
  evidenceSnapshot       Json     @map("evidence_snapshot")
  selectedBy             String?  @map("selected_by")
  selectedAt             DateTime @default(now()) @map("selected_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company              Company              @relation(fields: [companyId], references: [id])
  serviceCatalogueItem ServiceCatalogueItem @relation(fields: [serviceCatalogueItemId], references: [id])
  portfolioPhoto       PortfolioPhoto       @relation(fields: [portfolioPhotoId], references: [id])

  @@unique([serviceCatalogueItemId, portfolioPhotoId])
  @@index([companyId])
  @@index([portfolioPhotoId])
  @@map("photo_service_selections")
}

// Business Context Layer — structured company knowledge used by later
// Website, Business Growth, Communication and Process Planning workflows.
// This does not duplicate operational records such as clients/jobs/photos;
// those stay in their own modules. It stores explicit context items such as
// company profile facts, industries, activities, regions, pricing/work rules,
// communication tone and approval/capacity rules. Every item records its
// source and verification status so future content generation can distinguish
// real entered facts from unverified notes instead of inventing claims.
model BusinessContextItem {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  category           String
  label              String
  value              String
  source             String   @default("user_input")
  verificationStatus String   @default("user_entered") @map("verification_status")
  notes              String?
  isActive           Boolean  @default(true) @map("is_active")
  createdBy          String?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, category])
  @@map("business_context_items")
}

// Basic Industry Model — a structured company taxonomy distinct from free-
// text Business Context. Each industry is explicit and source-labelled; its
// service links point only to real Service Catalogue entries.
model Industry {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  name               String
  description        String?
  source             String   @default("user_input")
  verificationStatus String   @default("user_entered") @map("verification_status")
  notes              String?
  isActive           Boolean  @default(true) @map("is_active")
  createdBy          String?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company      Company               @relation(fields: [companyId], references: [id])
  serviceLinks IndustryServiceLink[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("industries")
}

model IndustryServiceLink {
  id                     String   @id @default(uuid())
  companyId              String   @map("company_id")
  industryId             String   @map("industry_id")
  serviceCatalogueItemId String   @map("service_catalogue_item_id")
  notes                  String?
  isActive               Boolean  @default(true) @map("is_active")
  createdBy              String?  @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company              Company              @relation(fields: [companyId], references: [id])
  industry             Industry             @relation(fields: [industryId], references: [id])
  serviceCatalogueItem ServiceCatalogueItem @relation(fields: [serviceCatalogueItemId], references: [id])

  @@unique([industryId, serviceCatalogueItemId])
  @@index([companyId])
  @@index([serviceCatalogueItemId])
  @@map("industry_service_links")
}

// Website Management / Business Growth MVP slice. An audit stores only
// explicit observations supplied by the user or a future authorised website
// connector, then compares them deterministically with the company's real
// Service Catalogue, confirmed Business Context and reviewed Portfolio data.
// It never fetches or publishes a website in this connector-free slice and
// never turns missing data into an invented marketing claim.
model WebsiteAudit {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  websiteUrl        String   @map("website_url")
  status            String   @default("completed")
  observationSource String   @default("manual_observation") @map("observation_source")
  observations      Json
  notes             String?
  pageCount         Int      @map("page_count")
  findingCount      Int      @map("finding_count")
  urgentCount       Int      @default(0) @map("urgent_count")
  warningCount      Int      @default(0) @map("warning_count")
  infoCount         Int      @default(0) @map("info_count")
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  company          Company                  @relation(fields: [companyId], references: [id])
  findings         WebsiteAuditFinding[]
  contentProposals WebsiteContentProposal[]

  @@index([companyId, createdAt])
  @@map("website_audits")
}

model WebsiteAuditFinding {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  websiteAuditId String   @map("website_audit_id")
  category       String
  severity       String
  title          String
  evidence       String
  recommendation String
  pageUrl        String?  @map("page_url")
  sourceType     String   @map("source_type")
  sourceRecordId String?  @map("source_record_id")
  status         String   @default("open")
  createdAt      DateTime @default(now()) @map("created_at")

  company Company      @relation(fields: [companyId], references: [id])
  audit   WebsiteAudit @relation(fields: [websiteAuditId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([websiteAuditId])
  @@map("website_audit_findings")
}

// Website Content Workflow — a proposal is an internal, reviewable draft
// backed by an immutable snapshot of the real Secretary records selected as
// evidence. This slice can prepare, approve or reject proposals only. Public
// publishing and post-publication verification remain separate future risk-4
// connector actions and cannot be triggered by changing this record.
model WebsiteContentProposal {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  websiteAuditId String?   @map("website_audit_id")
  proposalType   String    @map("proposal_type")
  targetPageUrl  String    @map("target_page_url")
  headline       String?
  contentBody    String    @map("content_body")
  status         String    @default("ready_for_review")
  sourceSnapshot Json      @map("source_snapshot")
  notes          String?
  decisionNotes  String?   @map("decision_notes")
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  websiteAudit WebsiteAudit? @relation(fields: [websiteAuditId], references: [id])

  @@index([companyId, status])
  @@index([websiteAuditId])
  @@map("website_content_proposals")
}

model AuditLog {
  id                   String   @id @default(uuid())
  companyId            String   @map("company_id")
  userId               String?  @map("user_id")
  actionName           String   @map("action_name")
  interpretedIntent    String?  @map("interpreted_intent")
  inputPayload         Json?    @map("input_payload")
  dataBefore           Json?    @map("data_before")
  dataAfter            Json?    @map("data_after")
  riskLevel            Int      @map("risk_level")
  confirmationRequired Boolean  @default(false) @map("confirmation_required")
  confirmed            Boolean  @default(false)
  result               String
  errorMessage         String?  @map("error_message")
  createdAt            DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@map("audit_log")
}
