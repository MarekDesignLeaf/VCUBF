// Secretary Core data model — VCUF backend
// Every table belongs to a company (multi-tenant from day one).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users               User[]
  clients             Client[]
  jobs                Job[]
  leads               Lead[]
  auditLogs           AuditLog[]
  serviceCatalogueItems ServiceCatalogueItem[]
  quotes              Quote[]
  jobOpenings         JobOpening[]
  candidates          Candidate[]
  playbooks           Playbook[]
  playbookRuns        PlaybookRun[]
  learningRules       LearningRule[]

  @@map("companies")
}

model User {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  email               String   @unique
  passwordHash        String   @map("password_hash")
  displayName         String   @map("display_name")
  role                String   @default("worker")
  permissions         String[]
  // Job Allocation and Capacity Management Module — real capacity inputs.
  // Skills are free-text technical tags (e.g. "electrical", "plastering"),
  // entered by the user/admin — never invented by the system.
  skills              String[] @default([])
  weeklyCapacityHours Int      @default(40) @map("weekly_capacity_hours")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  company       Company    @relation(fields: [companyId], references: [id])
  auditLogs     AuditLog[]
  assignedJobs  Job[]      @relation("AssignedJobs")

  @@map("users")
}

model Client {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  displayName     String   @map("display_name")
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  companyName     String?  @map("company_name")
  emailPrimary    String?  @map("email_primary")
  phonePrimary    String?  @map("phone_primary")
  clientType      String?  @map("client_type")
  billingLine1    String?  @map("billing_address_line1")
  billingCity     String?  @map("billing_city")
  billingPostcode String?  @map("billing_postcode")
  notes           String?
  source          String?
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  jobs    Job[]
  quotes  Quote[]

  @@index([companyId])
  @@map("clients")
}

model Job {
  id                     String    @id @default(uuid())
  companyId              String    @map("company_id")
  clientId               String    @map("client_id")
  jobTitle               String    @map("job_title")
  jobStatus              String    @default("nova") @map("job_status")
  propertyAddress        String?   @map("property_address")
  assignedUserId         String?   @map("assigned_user_id")
  // Job Allocation and Capacity Management Module — real inputs used to
  // compute capacity. Optional because not every job has an estimate yet;
  // capacity checks explicitly report when a job cannot be counted because
  // this data is missing (the system must say what is missing, not guess).
  estimatedDurationHours Float?    @map("estimated_duration_hours")
  requiredSkills         String[]  @default([]) @map("required_skills")
  // Service Catalogue Module — optional link back to the catalogue entry
  // this job was based on, so pricing/duration data entered once in the
  // catalogue can be reused (and later rolled up for profitability),
  // without forcing every job to originate from a catalogue item.
  serviceCatalogueItemId String?   @map("service_catalogue_item_id")
  plannedStartAt         DateTime? @map("planned_start_at")
  plannedEndAt            DateTime? @map("planned_end_at")
  notes                  String?
  createdBy              String?   @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  client              Client               @relation(fields: [clientId], references: [id])
  assignedUser        User?                @relation("AssignedJobs", fields: [assignedUserId], references: [id])
  serviceCatalogueItem ServiceCatalogueItem? @relation(fields: [serviceCatalogueItemId], references: [id])
  quotes              Quote[]

  @@index([companyId])
  @@index([clientId])
  @@index([assignedUserId])
  @@index([serviceCatalogueItemId])
  @@map("jobs")
}


model Lead {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  name              String
  phone             String?
  email             String?
  serviceRequested  String?   @map("service_requested")
  location          String?
  source            String?
  urgency           String?
  leadStatus        String    @default("new") @map("lead_status")
  notes             String?
  convertedClientId String?   @map("converted_client_id")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("leads")
}

// Service Catalogue Module — the company's real, user-entered menu of
// services. Nothing here is invented by the system: name, description,
// pricing and duration are entered by the user and are used later to
// prefill jobs and (eventually) quotes and website content, so the same
// real facts propagate everywhere instead of being retyped or guessed.
model ServiceCatalogueItem {
  id                     String   @id @default(uuid())
  companyId              String   @map("company_id")
  name                   String
  description            String?
  category               String?
  basePriceMin           Float?   @map("base_price_min")
  basePriceMax           Float?   @map("base_price_max")
  priceUnit              String?  @map("price_unit")
  defaultDurationHours   Float?   @map("default_duration_hours")
  defaultRequiredSkills  String[] @default([]) @map("default_required_skills")
  isActive               Boolean  @default(true) @map("is_active")
  createdBy              String?  @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  jobs    Job[]
  quoteItems QuoteItem[]

  @@index([companyId])
  @@map("service_catalogue_items")
}


// Quote, Pricing and Profitability Module — turns real service-catalogue
// prices and real job data into a real, itemised quote for a client, and
// computes actual margin from real entered costs. Nothing here is invented:
// unit prices and unit costs are either pulled from a service catalogue
// entry the user created, or typed in directly. If a cost is not entered,
// margin is left unknown for that line rather than assumed to be 100%.
model Quote {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  clientId    String   @map("client_id")
  jobId       String?  @map("job_id")
  title       String
  quoteStatus String   @default("draft") @map("quote_status")
  notes       String?
  validUntil  DateTime? @map("valid_until")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id])
  client  Client      @relation(fields: [clientId], references: [id])
  job     Job?        @relation(fields: [jobId], references: [id])
  items   QuoteItem[]

  @@index([companyId])
  @@index([clientId])
  @@index([jobId])
  @@map("quotes")
}

model QuoteItem {
  id                     String   @id @default(uuid())
  quoteId                String   @map("quote_id")
  serviceCatalogueItemId String?  @map("service_catalogue_item_id")
  description            String
  quantity                Float   @default(1)
  unitPrice               Float   @map("unit_price")
  unitCost                Float?  @map("unit_cost")
  sortOrder               Int     @default(0) @map("sort_order")
  createdAt               DateTime @default(now()) @map("created_at")

  quote                Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceCatalogueItem ServiceCatalogueItem? @relation(fields: [serviceCatalogueItemId], references: [id])

  @@index([quoteId])
  @@index([serviceCatalogueItemId])
  @@map("quote_items")
}


// Recruitment and Workforce Expansion Module — see project instructions
// section 6. Every field here is what the user entered: reason, urgency,
// required skills, experience and language requirements are never invented,
// and the module never legally hires anyone, sets a wage, or confirms
// employment terms — it only tracks openings and candidates and drafts
// content for the user to review and use elsewhere.
model JobOpening {
  id                        String   @id @default(uuid())
  companyId                 String   @map("company_id")
  title                     String
  reason                    String?
  urgency                   String   @default("medium")
  openingStatus             String   @default("draft") @map("opening_status")
  skillsRequired            String[] @default([]) @map("skills_required")
  expectedTasks             String?  @map("expected_tasks")
  minExperienceYears        Float?   @map("min_experience_years")
  preferredExperienceYears  Float?   @map("preferred_experience_years")
  languageRequirements      String[] @default([]) @map("language_requirements")
  availabilityRequirements  String?  @map("availability_requirements")
  description               String?
  // The generated advert is stored so it can be reviewed and reused, but it
  // is only ever built from the real fields above — see
  // recruitmentService.buildAdvertText. Nothing is published automatically;
  // there is no job-board connector.
  draftAdvertText           String?  @map("draft_advert_text")
  createdBy                 String?  @map("created_by")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id])
  candidates Candidate[]

  @@index([companyId])
  @@map("job_openings")
}

model Candidate {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  jobOpeningId String   @map("job_opening_id")
  name         String
  email        String?
  phone        String?
  stage        String   @default("new")
  notes        String?
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id])
  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id])

  @@index([companyId])
  @@index([jobOpeningId])
  @@map("candidates")
}


// Playbook Engine — a saved, reusable workflow: an ordered list of Voice/Text
// Command Layer templates (the same syntax a user could type by hand, with
// {placeholder} variables). Running a playbook resolves the placeholders and
// dispatches each step through the exact same Action Engine
// (dispatchParsedCommand) a typed command would use — there is no separate,
// divergent execution path, and no business logic lives only in a prompt.
// Running a playbook is itself a risky, potentially multi-step action, so it
// follows the confirmationRequired pattern established for employee
// management: a request without confirmed: true returns a preview of every
// resolved step and its interpreted intent, and changes nothing.
model Playbook {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  name          String
  description   String?
  stepTemplates String[] @default([]) @map("step_templates")
  isActive      Boolean  @default(true) @map("is_active")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyId], references: [id])
  runs    PlaybookRun[]

  @@index([companyId])
  @@map("playbooks")
}

model PlaybookRun {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  playbookId  String   @map("playbook_id")
  triggeredBy String?  @map("triggered_by")
  variables   Json?
  stepResults Json
  overallOk   Boolean  @map("overall_ok")
  createdAt   DateTime @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id])
  playbook Playbook @relation(fields: [playbookId], references: [id])

  @@index([companyId])
  @@index([playbookId])
  @@map("playbook_runs")
}


// Learning Engine — see project instructions section 11 and the MVP
// priority list ("basic learning of aliases and workflows"). The strongest
// learning signal is explicit user correction/teaching, never an inferred
// guess — so every rule here is created deliberately by a user, is visible,
// editable and reversible (archive, don't hard-delete-and-forget), and
// nothing here silently overrides system behaviour on a single weak signal.
// A rule with aliasFor set is also used as a real text-substitution step
// (LearningEngine#resolveLearningAliases) applied before the Voice/Text
// Command Layer parses a command, so a learned alias actually changes how
// commands and playbook steps are interpreted — not just a static glossary.
model LearningRule {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  term       String
  meaning    String
  aliasFor   String?  @map("alias_for")
  category   String?
  status     String   @default("active")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("learning_rules")
}

model AuditLog {
  id                   String   @id @default(uuid())
  companyId            String   @map("company_id")
  userId               String?  @map("user_id")
  actionName           String   @map("action_name")
  interpretedIntent    String?  @map("interpreted_intent")
  inputPayload         Json?    @map("input_payload")
  dataBefore           Json?    @map("data_before")
  dataAfter            Json?    @map("data_after")
  riskLevel            Int      @map("risk_level")
  confirmationRequired Boolean  @default(false) @map("confirmation_required")
  confirmed            Boolean  @default(false)
  result               String
  errorMessage         String?  @map("error_message")
  createdAt            DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@map("audit_log")
}
