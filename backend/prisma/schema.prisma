// Secretary Core data model — VCUF backend
// Every table belongs to a company (multi-tenant from day one).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  clients   Client[]
  jobs      Job[]
  leads     Lead[]
  auditLogs AuditLog[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         String   @default("worker")
  permissions  String[]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  company   Company    @relation(fields: [companyId], references: [id])
  auditLogs AuditLog[]

  @@map("users")
}

model Client {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  displayName     String   @map("display_name")
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  companyName     String?  @map("company_name")
  emailPrimary    String?  @map("email_primary")
  phonePrimary    String?  @map("phone_primary")
  clientType      String?  @map("client_type")
  billingLine1    String?  @map("billing_address_line1")
  billingCity     String?  @map("billing_city")
  billingPostcode String?  @map("billing_postcode")
  notes           String?
  source          String?
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  jobs    Job[]

  @@index([companyId])
  @@map("clients")
}

model Job {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  clientId        String    @map("client_id")
  jobTitle        String    @map("job_title")
  jobStatus       String    @default("nova") @map("job_status")
  propertyAddress String?   @map("property_address")
  assignedUserId  String?   @map("assigned_user_id")
  plannedStartAt  DateTime? @map("planned_start_at")
  plannedEndAt    DateTime? @map("planned_end_at")
  notes           String?
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  @@index([companyId])
  @@index([clientId])
  @@map("jobs")
}


model Lead {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  name              String
  phone             String?
  email             String?
  serviceRequested  String?   @map("service_requested")
  location          String?
  source            String?
  urgency           String?
  leadStatus        String    @default("new") @map("lead_status")
  notes             String?
  convertedClientId String?   @map("converted_client_id")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("leads")
}

model AuditLog {
  id                   String   @id @default(uuid())
  companyId            String   @map("company_id")
  userId               String?  @map("user_id")
  actionName           String   @map("action_name")
  interpretedIntent    String?  @map("interpreted_intent")
  inputPayload         Json?    @map("input_payload")
  dataBefore           Json?    @map("data_before")
  dataAfter            Json?    @map("data_after")
  riskLevel            Int      @map("risk_level")
  confirmationRequired Boolean  @default(false) @map("confirmation_required")
  confirmed            Boolean  @default(false)
  result               String
  errorMessage         String?  @map("error_message")
  createdAt            DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@map("audit_log")
}
