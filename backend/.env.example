DATABASE_URL="postgresql://vcuf:vcuf@localhost:5432/vcuf?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Google Cloud OAuth web client. Keep real values outside source control and
# register the redirect URI exactly as configured in Google Cloud Console.
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REDIRECT_URI="http://localhost:4000/connectors/gmail/oauth/callback"

# 32 random bytes encoded as base64. Used only for AES-256-GCM encryption of
# connector token bundles; rotate through an explicit migration, never by
# replacing the value while encrypted credentials still exist.
CONNECTOR_ENCRYPTION_KEY=""
